    {
      "files": [
        "battle/observation/LiveActiveHpBarWitnesses.kt"
      ],
      "change": "HP-only damage evidence must exceed a 3.5-pixel edge uncertainty scaled to measured bar width. Raw HP observations remain available. Small hits may still be counted from independent border flashes."
    },
    {
      "files": [
        "battle/observation/PersistedActiveHpBarBorderCadenceWitness.kt"
      ],
      "change": "Require at least 35 percent of outline samples to carry pulse colors; both orange and blue remain eligible. Weak 11-24 percent blue shifts no longer establish pulses."
    },
    {
      "files": [
        "battle/observation/TeamRosterSpeciesAttributor.kt",
        "battle/observation/Match.kt",
        "battle/replay/ReplaySpeciesAttribution.kt"
      ],
      "change": "Independent replacement badge closes a faint vacancy; capture timestamps prevent late faint delivery reopening an already filled vacancy."
    },
    {
